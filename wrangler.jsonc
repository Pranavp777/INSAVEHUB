{
  "name": "insavehub",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "DJANGO_SETTINGS_MODULE": "config.settings",
    "DJANGO_ENV": "production",
    "DJANGO_DEBUG": "False",
    "PAYMENT_PROVIDER": "razorpay",
    "DONATION_CURRENCY": "INR",
    "AD_COUNTDOWN_SECONDS": "30",
    "FREE_ACCESS_HOURS": "24"
  }
}
