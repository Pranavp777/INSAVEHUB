# ==============================================================================
# INSAVE HUB - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env for local development.
# For Cloudflare Workers production, set secrets via `npx wrangler secret put`.
# ==============================================================================

# Core Django Settings
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-cryptographically-secure-50-character-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.workers.dev
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.workers.dev
CANONICAL_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL, SQLite, or Cloudflare D1)
# Leave DATABASE_URL blank in local development to default to SQLite (db.sqlite3)
# Example PostgreSQL: postgres://user:password@hostname:5432/insave_hub
DATABASE_URL=
USE_CLOUDFLARE_D1=False
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=

# Redis / Cache Configuration (Optional - falls back to database/local memory cache)
REDIS_URL=

# Cloudflare R2 Object Storage (Optional - for media/static storage)
USE_CLOUDFLARE_R2=False
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=insave-hub-media
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Google OAuth 2.0 Credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback/

# Payment / Donation Gateway (Razorpay for India / Custom Compatible)
PAYMENT_PROVIDER=razorpay
DONATION_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Platform Access & Interstitial Rules
AD_COUNTDOWN_SECONDS=30
FREE_ACCESS_HOURS=24
FREE_DOWNLOADS_BEFORE_AD=1

# Production Instagram Post, Reel & Video Downloading Settings
INSTAGRAM_EXTRACTOR_TIMEOUT=18
INSTAGRAM_DOWNLOAD_STREAM_TIMEOUT=45
INSTAGRAM_MAX_DOWNLOAD_SIZE_MB=150
# Optional: Set INSTAGRAM_SESSIONID or INSTAGRAM_COOKIES_FILE if deploying on a datacenter IP
# where Instagram rate-limits anonymous requests.
INSTAGRAM_SESSIONID=
INSTAGRAM_COOKIES_FILE=
INSTAGRAM_PROXY_URL=

# Rate Limiting Defaults (Requests per minute unless noted)
RATE_LIMIT_ANALYZE_PER_MIN=15
RATE_LIMIT_DOWNLOAD_PER_MIN=10
RATE_LIMIT_AUTH_PER_MIN=8
RATE_LIMIT_PASSWORD_RESET_PER_HOUR=5
RATE_LIMIT_OAUTH_PER_MIN=10
RATE_LIMIT_DONATION_PER_MIN=6

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@insavehub.example.com

